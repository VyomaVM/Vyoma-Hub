# ==========================================
# Vyoma Hub Environment Configuration
# ==========================================

# Server Host & Port
HOST=0.0.0.0
PORT=8080
RUST_LOG=info,vyoma_hub=debug,tower_http=info

# Database (PostgreSQL 16)
DATABASE_URL=postgres://postgres:vyomapassword@localhost:5432/vyoma_hub
DATABASE_MAX_CONNECTIONS=50

# Cache & Rate Limiting (Redis 7)
REDIS_URL=redis://127.0.0.1:6379

# Object Storage (MinIO locally / Cloudflare R2 in prod)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=vyoma-hub-blobs
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_FORCE_PATH_STYLE=true

# Authentication & Tokens
JWT_SECRET=vyoma_hub_dev_secret_key_change_me_in_production_min_32_bytes_long!
TOKEN_ISSUER=hub.vyoma.dev
TOKEN_EXPIRY_HOURS=24

# External URL (for OCI WWW-Authenticate header challenge)
HUB_PUBLIC_URL=http://localhost:8080
WEB_PUBLIC_URL=http://localhost:3000
